# Copy to `.env` beside compose.yaml. Only the first line is required.

# A Jellyfin API key: Dashboard -> API Keys. It needs to list users, read their
# user data, and create and update playlists.
JELLYFIN_TOKEN=

# Where Jellyfin is, from inside this container. The compose default assumes
# they share a docker network.
#JELLYFIN_URL=http://jellyfin:8096

# The audiobook libraries to model. Unset means every library Jellyfin reports
# with a collection type of `books`, which is usually what you want.
#LIBRARY_IDS=

# The identity assumed when the forward-auth header is absent. Leave it unset
# behind a proxy that sets one; set it for direct access without a proxy.
#JELLYFIN_USER=

# Optional. Without it, requesting a book is unavailable and the rest works.
#LISTENARR_URL=http://listenarr:4545
#LISTENARR_QUALITY_PROFILE_ID=1

# Audible marketplaces to search, in preference order: us, ca, uk, au, de, fr,
# it, es, jp, in, br. An ASIN sold in one is not necessarily in another, and a
# lookup in the wrong one answers 200 with an empty product.
#AUDIBLE_REGIONS=ca,us

# A hidden suggestion becomes eligible again after this cooling-off period.
#DISMISS_TTL_DAYS=30

# Ranked snapshots and attributed feedback older than this are pruned.
#ATTRIBUTION_RETENTION_DAYS=180
